      "id": "sales-month-wise",
      "type": "table",
      "title": "Sales Month Wise (In Lakhs)",
      "description": "Sales grouped by month for the current financial year.",
      "width": 6,
      "visible": true,
      "position": {
        "x": 0,
        "y": 1
      },
      "queryDefinition": {
        "format": "sql",
        "resource": "widgets/sales-month-wise"
      },
      "columns": [
        {
          "field": "Month",
          "header": "Month"
        },
        {
          "field": "Sales",
          "header": "Sales",
          "dataType": "number"
        }
      ],
      "sort": [
        {
          "field": "Month",
          "direction": "DESC"
        }
      ],
      "pageSize": 10,
      "export": {
        "enabled": true,
