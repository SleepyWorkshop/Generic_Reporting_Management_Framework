# Public browser configuration only. Never place backend secrets in VITE_* values.
# Local development (match the port used by the PHP development server).
# The client keeps localhost/127.0.0.1 aligned with the browser host so the
# SameSite session cookie remains available to CSRF-protected requests:
VITE_API_URL=http://localhost:8000/index.php

# Production should use the same HTTPS origin through Nginx:
# VITE_API_URL=/api
